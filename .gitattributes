# Files that are executed or parsed on Linux must keep LF endings whatever the
# checkout platform. With CRLF, a shell script fails immediately with
# "$'\r': command not found", and RPM spec scriptlets fail the same way.
*.sh        text eol=lf
*.spec      text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
