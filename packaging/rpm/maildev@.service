[Unit]
# Template unit for running several independent MailDev instances side by side:
#
#     cp /usr/share/doc/maildev/instance.conf.example /etc/maildev/instances/dev.conf
#     $EDITOR /etc/maildev/instances/dev.conf     # pick unused ports
#     systemctl enable --now maildev@dev
#
# Each instance gets its own config, its own mail directory, and its own ports.
Description=MailDev (%i) - SMTP server and web interface for testing email
Documentation=https://github.com/maildev/maildev
After=network-online.target
Wants=network-online.target

# Give up rather than retry forever. A missing instance config or a port already
# in use is a permanent error, and with RestartSec=5 the default start limit
# (5 attempts per 10s) is never reached, so the unit would retry indefinitely
# instead of settling into 'failed' where it is visible.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=maildev
Group=maildev

# Captured mail is kept per instance, so instances never see each other's mail.
# The EnvironmentFile can override this, but the default keeps them separate
# without any configuration.
Environment=MAILDEV_MAIL_DIRECTORY=/var/lib/maildev/%i

# Deliberately not optional: two instances cannot share ports, so starting
# without instance configuration would just collide on the defaults. A missing
# file fails the unit with a clear message instead.
EnvironmentFile=/etc/maildev/instances/%i.conf

ExecStart=/usr/bin/maildev
WorkingDirectory=/var/lib/maildev/%i
Restart=on-failure
RestartSec=5s

StateDirectory=maildev/%i
ReadWritePaths=/var/lib/maildev/%i

# The default ports (1025/1080) are unprivileged, so the service needs no
# capabilities at all. Lower an instance's ports below 1024 only if you also add
# AmbientCapabilities=CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
# AF_NETLINK is required: Node's os.networkInterfaces() goes through
# getifaddrs(), which opens a netlink socket. Without it the process dies at
# startup with "uv_interface_addresses returned Unknown system error 97".
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027

[Install]
WantedBy=multi-user.target
